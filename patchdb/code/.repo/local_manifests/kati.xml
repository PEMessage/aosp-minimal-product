<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local manifest: bring back the ckati sources (platform/build/kati).

  Android 11+ ships ckati only as a prebuilt (prebuilts/build-tools) and no
  release manifest carries the kati repo, so path=build/kati must be restored
  here. An explicit SHA is required because the default `aosp` revision
  (android-12.1.0_r22) has no matching tag in build/kati.

  The SHA (9f48932c90ca, 2021-10-20) is the newest main-branch commit still
  consistent with the prebuilt binary: the binary reports kGitVersion="unknown",
  but feature-string dating brackets its source to 2021-02-23 (.KATI_ALLOW_RULES
  present) .. 2021-10-25 (.SHELLSTATUS absent), and this is the last anchor
  before .SHELLSTATUS.

  USTC (not the default TUNA "aosp") is used only for this project: TUNA rejects
  short-SHA fetches and queues full-SHA ones behind a long slow queue, while
  USTC serves full-SHA shallow fetches directly.

  Source tweaks live under patchdb/code/build/kati/; this manifest itself is the
  patchman copy entry patchdb/code/.repo/local_manifests/kati.xml, applied by
  bootstrap.sh before sync_deps fetches build/kati.
-->
<manifest>
  <remote name="ustc-aosp"
          fetch="https://mirrors.ustc.edu.cn/aosp/"
          review="android-review.googlesource.com" />

  <project path="build/kati"
           name="platform/build/kati"
           remote="ustc-aosp"
           revision="9f48932c90ca93bc1777561cc22d1a2587bc0333"
           groups="pdk,tradefed"
           clone-depth="1" />
</manifest>
