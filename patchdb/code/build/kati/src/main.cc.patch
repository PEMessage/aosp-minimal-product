+// CKATI_WAIT_USR2 hook: set by HandleWaitUsr2Resume() when SIGUSR2 arrives.
+static volatile sig_atomic_t g_wait_usr2_resume = 0;
+static void HandleWaitUsr2Resume(int) {
+  g_wait_usr2_resume = 1;
+}
+
 int main(int argc, char* argv[]) {
-  if (argc >= 2 && !strcmp(argv[1], "--realpath")) {
+  // Debug hook: when CKATI_WAIT_USR2 is set, wait before any makefile work
+  // until released with SIGUSR2 (see bin/ckati-attach).
+  // A signal-driven wait is used instead of raise(SIGSTOP) because the
+  // Android build runs ckati inside an nsjail PID namespace, where ckati is
+  // PID 1 and the kernel silently ignores self-delivered SIGSTOP.
+  // Usage: CKATI_WAIT_USR2=1 <build cmd>, then: bin/ckati-attach
+  bool realpath_mode = (argc >= 2 && !strcmp(argv[1], "--realpath"));
+  if (!realpath_mode && getenv("CKATI_WAIT_USR2")) {
+    signal(SIGUSR2, HandleWaitUsr2Resume);
+    fprintf(stderr, "[ckati] CKATI_WAIT_USR2: pid %d waiting; attach a debugger, "
+                    "then send SIGUSR2 to continue\n", getpid());
+    while (!g_wait_usr2_resume) {
+      sleep(1);
+    }
+  }
+  if (realpath_mode) {
     HandleRealpath(argc - 2, argv + 2);
     return 0;
   }
