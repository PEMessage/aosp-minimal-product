 int main(int argc, char* argv[]) {
-  if (argc >= 2 && !strcmp(argv[1], "--realpath")) {
+  // Debug hook: when CKATI_WAIT_GDB is set, self-stop with SIGSTOP so a
+  // debugger can attach before any makefile work happens.
+  // Usage: CKATI_WAIT_GDB=1 <build cmd>, then: gdb <this ckati> -p <pid>.
+  bool realpath_mode = (argc >= 2 && !strcmp(argv[1], "--realpath"));
+  if (!realpath_mode && getenv("CKATI_WAIT_GDB")) {
+    fprintf(stderr, "[ckati] CKATI_WAIT_GDB: pid %d stopped (SIGSTOP); "
+                    "attach a debugger, then 'continue'\n", getpid());
+    raise(SIGSTOP);
+  }
+  if (realpath_mode) {
     HandleRealpath(argc - 2, argv + 2);
     return 0;
   }
